{
  "name": "fuka",
  "version": "0.1.0",
  "description": "Fuka - QQ AI Agent with social memory capabilities",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:PromiseTracker": "npm test -- --testPathPattern=PromiseTracker",
    "test:InterestGraph": "npm test -- --testPathPattern=InterestGraph",
    "test:ProfileGen": "npm test -- --testPathPattern=ProfileGen",
    "db:migrate": "node db/migrations/run.js",
    "cli": "node cli/index.js",
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dead-code": "fallow dead-code",
    "health": "fallow health",
    "audit": "fallow audit",
    "demo:promise": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='extractor.test' --verbose",
    "demo:interest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='tagger.test' --verbose",
    "demo:profile:conf": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='confidence.test' --verbose",
    "demo:profile:analyze": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern='analyzer.test' --verbose",
    "demo": "pnpm demo:promise && pnpm demo:interest && pnpm demo:profile:conf && pnpm demo:profile:analyze"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "fallow": "^2.62.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.6.0"
  }
}
